rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ───────────────────────────────────────────────────────────────
    function autenticado() { return request.auth != null; }
    function esDueno(uid)  { return autenticado() && request.auth.uid == uid; }
    function yo() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data;
    }
    function esAdmin() { return autenticado() && yo().rol == 'admin'; }
    // Un veterinario desactivado pierde sus permisos.
    function esVeterinario() {
      return autenticado() && yo().rol == 'veterinario' && yo().get('activo', true) == true;
    }
    function cambiaSolo(campos) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(campos);
    }

    // ── USUARIOS ──────────────────────────────────────────────────────────────
    match /usuarios/{uid} {
      allow read: if esDueno(uid) || esAdmin();
      // El veterinario abre el perfil del dueño de una cita (uno a uno, sin
      // poder listar a todos los usuarios).
      allow get: if esVeterinario();
      // Cualquiera con sesión ve a los veterinarios, para elegir al agendar.
      allow read: if autenticado() && resource.data.rol == 'veterinario';

      // Al registrarse solo se puede crear una cuenta de usuario normal.
      allow create: if esDueno(uid)
                    && request.resource.data.rol == 'usuario'
                    && request.resource.data.get('activo', true) == true;
      // Cada quien edita sus datos, pero no su rol ni su estado.
      allow update: if esDueno(uid)
                    && request.resource.data.rol == resource.data.rol
                    && request.resource.data.get('activo', true) == resource.data.get('activo', true);
      // El veterinario solo puede tocar las mascotas (registrar vacunas).
      allow update: if esVeterinario() && cambiaSolo(['mascotas']);
      allow write: if esAdmin();

      // ── CITAS ───────────────────────────────────────────────────────────────
      match /citas/{citaId} {
        allow read: if esDueno(uid) || esAdmin();
        allow read: if esVeterinario() && resource.data.veterinarioId == request.auth.uid;

        // El dueño agenda: siempre pendiente y, si elige veterinario, con su
        // horario reservado en la agenda dentro de la misma escritura.
        allow create: if esDueno(uid)
                      && request.resource.data.estado == 'pendiente'
                      && request.resource.data.duenoUid == uid
                      && request.resource.data.get('notas', '') == ''
                      && (request.resource.data.veterinarioId == null
                          || existsAfter(/databases/$(database)/documents/agenda/$(request.resource.data.veterinarioId + '_' + request.resource.data.fecha + '_' + request.resource.data.hora)));
        // El dueño solo puede cancelar una cita pendiente.
        allow update: if esDueno(uid)
                      && cambiaSolo(['estado'])
                      && resource.data.get('estado', 'pendiente') == 'pendiente'
                      && request.resource.data.estado == 'cancelada';
        // El veterinario asignado la marca atendida (o la reabre) y deja notas.
        allow update: if esVeterinario()
                      && resource.data.veterinarioId == request.auth.uid
                      && cambiaSolo(['estado', 'notas'])
                      && request.resource.data.estado in ['pendiente', 'atendida'];
        allow write: if esAdmin();
      }

      // ── CARRITO ─────────────────────────────────────────────────────────────
      match /carrito/{itemId} {
        allow read, write: if esDueno(uid);
      }

      // ── PEDIDOS ─────────────────────────────────────────────────────────────
      match /pedidos/{pedidoId} {
        allow read: if esDueno(uid) || esAdmin();
        // El dueño crea el pedido pendiente y ya no puede modificarlo.
        allow create: if esDueno(uid)
                      && request.resource.data.estado == 'pendiente'
                      && request.resource.data.uid == uid
                      && request.resource.data.total is number
                      && request.resource.data.total >= 0
                      && request.resource.data.items is list
                      && request.resource.data.items.size() > 0;
        // El admin solo cambia el estado.
        allow update: if esAdmin() && cambiaSolo(['estado'])
                      && request.resource.data.estado in ['pendiente', 'listo', 'entregado', 'cancelado'];
      }
    }

    // ── Consultas de grupo (todas las citas / pedidos de todos los usuarios) ──
    match /{path=**}/citas/{citaId} {
      allow read: if esAdmin();
      allow read: if esVeterinario() && resource.data.veterinarioId == request.auth.uid;
    }
    match /{path=**}/pedidos/{pedidoId} {
      allow read: if esAdmin();
    }

    // ── AGENDA: un documento por veterinario + fecha + hora ocupados ─────────
    match /agenda/{cupoId} {
      // Solo contiene quién y cuándo; sirve para mostrar horas ocupadas.
      allow read: if autenticado();
      // Crear = reservar. Como no se permite actualizar, un horario ya
      // reservado no se puede pisar. Debe corresponder a una cita real.
      allow create: if autenticado()
                    && cupoId == request.resource.data.veterinarioId + '_' + request.resource.data.fecha + '_' + request.resource.data.hora
                    && (request.resource.data.duenoUid == request.auth.uid || esAdmin())
                    && getAfter(/databases/$(database)/documents/usuarios/$(request.resource.data.duenoUid)/citas/$(request.resource.data.citaId)).data.veterinarioId == request.resource.data.veterinarioId;
      // `resource == null`: liberar un cupo que no existe (citas anteriores a
      // la agenda) no debe hacer fallar la cancelación.
      allow delete: if autenticado()
                    && (resource == null || resource.data.duenoUid == request.auth.uid || esAdmin());
    }

    // ── SERVICIOS Y CATÁLOGO DE VACUNAS ───────────────────────────────────────
    match /servicios/{servicioId} {
      allow read: if autenticado();
      allow write: if esAdmin();
    }
    match /vacunas_catalogo/{vacunaId} {
      allow read: if autenticado();
      allow write: if esAdmin();
    }

    // ── PRODUCTOS / TIENDA ────────────────────────────────────────────────────
    match /productos/{productoId} {
      allow read: if autenticado();
      allow write: if esAdmin();
      // Al comprar, un cliente solo puede bajar el stock, nunca dejarlo en
      // negativo ni tocar precio, nombre o visibilidad.
      // Que la rebaja coincida con un pedido real y que el total del pedido
      // sea correcto solo se puede garantizar del lado del servidor (Cloud
      // Function); aquí se limita el daño posible.
      allow update: if autenticado()
                    && cambiaSolo(['stock'])
                    && request.resource.data.stock is int
                    && request.resource.data.stock >= 0
                    && request.resource.data.stock < resource.data.stock;
    }
  }
}
